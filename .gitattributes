# Unity smart merge for scenes, prefabs, and other YAML assets.
# Resolves most non-conflicting scene/prefab merges automatically.
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.meta merge=unityyamlmerge eol=lf
*.anim merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf

# Normalize line endings for text/script/config assets
*.cs text diff=csharp eol=lf
*.cginc text eol=lf
*.shader text eol=lf
*.json text eol=lf mtn diff=json
*.xml text eol=lf

# Git LFS - binary/large asset types
*.psd filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
